{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/servicebrief",
      "has": [
        {
          "type": "query",
          "key": "name",
          "value": "(?<name>.+)"
        }
      ],
      "destination": "/services/:name",
      "permanent": true
    },
